<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 4.0-c316 44.253921, Sun Oct 01 2006 17:14:39">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:CreateDate>2022-06-02T17:51:05+05:30</xap:CreateDate>
         <xap:CreatorTool>LaTeX with hyperref package + hypdvips</xap:CreatorTool>
         <xap:ModifyDate>2022-06-03T21:45+05:30</xap:ModifyDate>
         <xap:MetadataDate>2022-06-03T21:45+05:30</xap:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Drawing data collected in 2021 from a probability sample of Hong Kong residents, we examine their political identity with the former colonists and their post-colonial ruler in China.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jennifer Sin Yu Hung and Brian Ying Yeung Ho</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Indigenization of Political Identity in Postcolonial Hong Kong</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>ethnic identity</rdf:li>
               <rdf:li>nationalism</rdf:li>
               <rdf:li>postcolonialism</rdf:li>
               <rdf:li>indigenization</rdf:li>
               <rdf:li>Hong Kong</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>ethnic identity, nationalism, postcolonialism, indigenization, Hong Kong</pdf:Keywords>
         <pdf:Producer>dvips + MiKTeX GPL Ghostscript  9.0</pdf:Producer>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
